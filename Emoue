    )
    loocv_error_distribution(
        y, y_cv,
        title=f"{name} — LOOCV error distribution",
        base_name=f"LOOCV_ErrorDist_{name}"
    )

    err = (y.values - y_cv)
    loocv_rows.append({
        "Model": name,
        "LOOCV_R2": float(r2_score(y, y_cv)),
        "LOOCV_RMSE": float(np.sqrt(mean_squared_error(y, y_cv))),
        "LOOCV_MAE": float(mean_absolute_error(y, y_cv)),
        "LOOCV_Error_mean": float(np.mean(err)),
        "LOOCV_Error_std": float(np.std(err))
    })

